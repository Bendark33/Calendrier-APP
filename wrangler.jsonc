{
  "name": "calendrier-app",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
   },
   "traces": {
     "enabled": true,
     "head_sampling_rate": 1,
     "persist": true
   },
   "issue_detection": {
     "enabled": true
   }
}
